# 공공데이터포털 (data.go.kr) 일반 인증키 (Decoding 또는 Encoding 키)
DATA_GO_KR_API_KEY=your_public_data_portal_api_key_here

# 텔레그램 봇 토큰 (BotFather를 통해 발급받은 토큰)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 텔레그램 Chat ID (메시지를 수신할 사용자의 숫자 ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 데이터 수집 주기 (초 단위, 기본 40초 추천)
COLLECT_INTERVAL_SEC=40
